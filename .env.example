# Copy to .env and fill in. Never commit .env.

# Leave unset to use a local SQLite file at data/pww.db (fine for Phase 0-1 dev).
# For Neon/Supabase use the pooled Postgres URL, with the psycopg driver prefix:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Optional: a URL whose page text contains today's WAPDA river/reservoir release.
# Pick one in Phase 0 task 2 (see docs/data_inventory.md).
PRESS_RELEASE_URL=
